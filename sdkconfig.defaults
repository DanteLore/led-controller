# Bluetooth stays out because the bt component isn't in the COMPONENTS list
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000

# WiFi and the web server don't fit the default 1MB app partition with room to grow
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Saving WiFi settings writes flash, which pauses the cache; this keeps the
# strip's RMT interrupt running meanwhile so a frame can't glitch
CONFIG_RMT_TX_ISR_CACHE_SAFE=y

# Per-task CPU time, read by /api/cpu
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
